rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Escudos dos times: qualquer usuário autenticado pode ler, apenas técnico pode enviar
    match /escudos/{teamId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de jogadores
    match /jogadores/{playerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
